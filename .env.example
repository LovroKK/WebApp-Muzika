# ============================================================
# PRIMJER environment varijabli. Kopiraj u .env i popuni vrijednosti:
#   copy .env.example .env   (Windows)
# .env sadrzi prave tajne i NE ide u git.
# ============================================================

# --- Baza ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=webapp_muzika

# --- JWT (bilo koji string min 32 znaka) ---
APP_JWT_SECRET=promijeniOvajTajniKljucNaMin32Znaka!

# --- Admin (bcrypt hash lozinke) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Stripe (TEST mode) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SUCCESS_URL=http://localhost:8081/payment-success.html
STRIPE_CANCEL_URL=http://localhost:8081/payment-cancel.html
